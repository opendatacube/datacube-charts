{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "additionalEnvironmentVars": {
      "type": "object"
    },
    "additionalSettings": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    },
    "annotations": {
      "type": "object"
    },
    "database": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "dockerArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "externalPort": {
      "type": "integer"
    },
    "hpa": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxReplicas": {
          "type": "integer"
        },
        "metrics": {
          "type": "array"
        },
        "minReplicas": {
          "type": "integer"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "pullPolicy": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        },
        "enabled": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ingressClassName": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pathType": {
          "type": "string"
        }
      }
    },
    "internalPort": {
      "type": "integer"
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "httpGet": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "initialDelaySeconds": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        },
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer"
        }
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "httpGet": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "initialDelaySeconds": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        }
      }
    },
    "replicaCount": {
      "type": "integer"
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        }
      }
    },
    "serviceAccountName": {
      "type": [
        "string",
        "null"
      ]
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "failureThreshold": {
          "type": "integer"
        },
        "httpGet": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "initialDelaySeconds": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        }
      }
    },
    "updateCreationDt": {
      "type": "object",
      "properties": {
        "backoffLimit": {
          "type": "integer"
        },
        "concurrencyPolicy": {
          "type": "string"
        },
        "cron": {
          "type": "string"
        },
        "dockerArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "historyLimit": {
          "type": "integer"
        },
        "suspend": {
          "type": "boolean"
        }
      }
    }
  }
}
