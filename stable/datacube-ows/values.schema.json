          "type": "string"
        }
      },
      "required": [
        "envName"
      ],
      "title": "clusterInfo",
      "type": "object"
    },
    "database": {
      "additionalProperties": false,
      "properties": {
        "database": {
          "default": "datacube",
          "title": "database",
          "type": "string"
        },
        "existingSecret": {
          "default": "",
          "description": "Name of an existing Secret holding `postgres-username` / `postgres-password`.",
          "required": [],
          "title": "existingSecret",
          "type": [
            "string",
            "null"
          ]
